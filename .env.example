# Environment template — copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Never put real secrets in this file. `.env*` is gitignored except this example.

# Public site origin (canonical URLs, Open Graph, sitemap, JSON-LD).
# NEXT_PUBLIC_ is inlined into the client bundle — only use it for values
# that must be visible in the browser. This origin is already public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only contact delivery. Never prefix these with NEXT_PUBLIC_.
# When set, POST /api/contact forwards validated submissions as JSON.
# Must be HTTPS to a public host (private IPs and credential URLs are rejected).
# Leave empty for local dev if you do not need outbound delivery.
CONTACT_FORM_WEBHOOK_URL=
# Optional Bearer token sent to the webhook (server-only).
CONTACT_FORM_WEBHOOK_TOKEN=
