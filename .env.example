# Public site origin used for canonical URLs, Open Graph, sitemap, and JSON-LD.
# Must be the production hostname (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://infozub.com

# Server-only contact delivery (never expose these to the browser).
# When set, POST /api/contact forwards validated submissions as JSON.
CONTACT_FORM_WEBHOOK_URL=
# Optional Bearer token sent to the webhook
CONTACT_FORM_WEBHOOK_TOKEN=
